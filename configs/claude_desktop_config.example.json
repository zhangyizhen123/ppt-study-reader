{
  "mcpServers": {
    "ppt_study_reader": {
      "command": "node",
      "args": [
        "/ABSOLUTE/PATH/TO/ppt-study-reader/server/index.mjs",
        "--data-dir=/ABSOLUTE/PATH/TO/ppt-study-reader-data"
      ],
      "env": {
        "PPT_COURSE_DIR": "/ABSOLUTE/PATH/TO/YOUR/COURSE_PDFS",
        "PPT_ANNOTATIONS_PATH": ""
      }
    }
  }
}
